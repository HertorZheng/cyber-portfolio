# local.rules
# Custom Snort rules written during TryHackMe "Snort Challenge – Live Attacks"
# Author: Hector Zhengliang
# Date: 08/31/2025
# Description: Detecting and blocking SSH brute force attempts and reverse shell activity


# Rule 1: Block SSH brute force attempts (TCP/22)
drop tcp any any -> any 22 (msg:"SSH Brute Force Block"; sid:1000001; rev:1;)


# Rule 2: Block Reverse Shell traffic via Metasploit (TCP/4444)
drop tcp any any -> any 4444 (msg:"Block Reverse Shell via Metasploit"; sid:1000002; rev:1;)
